// Archivo de tests de referencia, borrar luego de desarrollar propios
import personaje.*
import enemigos.*
import trampas.*
import movimientos.*
import pociones.*
import wollok.game.*

describe "Lionel se enfrenta con los enemigos" {
  test "El personaje arranca con 100 de vida" {
    assert.equals(100, personaje.vida())
  }
  test "Cuando el fantasma ataca, el personaje pierde 35 de vida" {
    fantasma1.teAtaca(personaje)
    assert.equals(65, personaje.vida())
  }
  test "Cuando la serpiente ataca, el personaje pierde 25 de vida" {
    serpiente1.teAtaca(personaje)
    assert.equals(75, personaje.vida())
  }
  test "Cuando el escorpion ataca, el personaje pierde 50 de vida" {
    escorpion1.teAtaca(personaje)
    assert.equals(50, personaje.vida())
  }
  test "Cuando dos enemigos atacan, el personaje pierde 60 de vida" {
    fantasma1.teAtaca(personaje)
    serpiente1.teAtaca(personaje)
    assert.equals(40, personaje.vida())
  } 
  test "La serpiente cambia de posicion al moverse" {
    const posicionInicial = serpiente1.position()
    serpiente1.movete()
    assert.notEquals(posicionInicial, serpiente1.position())
  }
  test "Cuando el personaje cae en el pozo, vuelve a su posición inicial" {
    personaje.position(game.at(7,5))
    pozo.teAbsorbe(personaje)
    assert.equals(game.origin(), personaje.position())
  }
}

describe "Limites de Lionel con el lugar" {
  test "Si el personaje se mueve más a la izquierda, se queda en la misma posición" {
    movimiento.mover(personaje, haciaLaIzquierda)
    assert.equals(game.at(0, 0), personaje.position())
  }
  test "Si el personaje se mueve más a la derecha, se queda en la misma posición" {
    personaje.position(game.at(14, 0))
    movimiento.mover(personaje, haciaLaDerecha)
    assert.equals(game.at(14, 0), personaje.position())
  }
  test "Si el personaje intenta bajar desde (0,0) queda en la misma posición" {
    movimiento.mover(personaje, haciaAbajo)
    assert.equals(game.origin(), personaje.position())
  }
}

describe "Pociones" {

    test "La pocion curativa recupera 20 de vida" {
        personaje.recibirDanio(30)
        const pocion = new PocionCurativa(position = game.at(1,1))
        game.addVisual(pocion)

        pocion.interactuar(personaje)

        assert.equals(90, personaje.vida())
    }

    test "La pocion venenosa quita 15 de vida" {
        const pocion = new PocionVenenosa(position = game.at(1,1))
        game.addVisual(pocion)

        pocion.interactuar(personaje)

        assert.equals(85, personaje.vida())
    }
}